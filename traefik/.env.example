# Load with: set -a; source .env; set +a
# Values containing $ must be single-quoted.

# Let's Encrypt
ACME_EMAIL=your-email@example.com

# Traefik dashboard
TRAEFIK_HOST=traefik.example.com

# Generate: openssl passwd -apr1 'your-password'
TRAEFIK_AUTH_USER=admin
TRAEFIK_AUTH_PASSWORD_HASH='$apr1$xxxxxxxx$xxxxxxxxxxxxxxxxxxxxxx'
TRAEFIK_DASHBOARD_ENABLED=true
